  {
   "type": "timeseries",
   "title": "Log lines / min by Node",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "tb-loki"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true,
      "axisPlacement": "auto",
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "tb-loki"
     },
     "expr": "sum by (tb_node) (count_over_time({tb_ns=~\"$ns\",tb_infra=~\"$infra\",tb_nodegroup=~\"$nodegroup\",tb_node=~\"$node\"} |= \"$search\" [1m]))",
     "legendFormat": "{{tb_node}}",
     "queryType": "range"
    }
   ],
