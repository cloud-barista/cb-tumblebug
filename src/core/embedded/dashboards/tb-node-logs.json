  {
   "type": "timeseries",
   "title": "Journal lines / min by level",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "tb-loki"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true,
      "axisPlacement": "auto",
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "unit": "short",
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "warning"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "info"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "debug"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true,
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "tb-loki"
     },
     "expr": "sum by (level) (count_over_time({tb_ns=~\"$ns\",tb_infra=~\"$infra\",tb_nodegroup=~\"$nodegroup\",tb_node=~\"$node\"} |= \"$search\" | scope_name=~\".*journald.*\" | json | __error__=\"\" | _SYSTEMD_UNIT=~\".*$unit.*\" | label_format level=`{{ if le .PRIORITY \"3\" }}error{{ else if eq .PRIORITY \"4\" }}warning{{ else if eq .PRIORITY \"7\" }}debug{{ else }}info{{ end }}` [1m]))",
     "legendFormat": "{{level}}",
     "queryType": "range"
    }
   ],
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 7
   }
  },
  {
   "type": "bargauge",
   "title": "Noisiest units",
   "description": "Journal lines per systemd unit in the selected range",
   "datasource": {
    "type": "loki",
    "uid": "tb-loki"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
