{
  "title": "CB-Tumblebug \u2014 Interactions & Load",
  "uid": "cb-interactions",
  "tags": [
    "cb-tumblebug",
    "interactions",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Inbound API \u2014 requests to cb-tumblebug (polling/utility excluded)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by method + path (per min)",
      "description": "All API requests (reads + writes) grouped by method + normalized path (first 5 segments; IDs/query stripped). High-frequency polling/utility endpoints are excluded, mirroring cb-tumblebug's logfilter skip lists.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "lineWidth": 1,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (Method, route) (count_over_time({namespace=\"cb-tumblebug\"} |= \"zerologger.go\" | json | message=~\"request( error)?\" | label_format route=`{{ regexReplaceAll \"^(/[^/?]+(?:/[^/?]+){0,4}).*$\" .URI \"${1}\" }}` | route !~ \"^/tumblebug/(api|readyz|livez|httpVersion|testStreamResponse|requests?)(/|$)\" [1m]))",
          "legendFormat": "{{Method}} {{route}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 by method + path",
      "description": "p95 server-side request duration by method (polling/utility excluded).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "showPoints": "never",
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {namespace=\"cb-tumblebug\"} |= \"zerologger.go\" | json | message=~\"request( error)?\" | label_format route=`{{ regexReplaceAll \"^(/[^/?]+(?:/[^/?]+){0,4}).*$\" .URI \"${1}\" }}` | route !~ \"^/tumblebug/(api|readyz|livez|httpVersion|testStreamResponse|requests?)(/|$)\" | unwrap duration(latency) [2m]) by (Method, route)",
          "legendFormat": "{{Method}} {{route}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
