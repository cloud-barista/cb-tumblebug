{
  "nsId": "system",
  "resourceType": "infra",
  "name": "infra-usecase-aws-ap-northeast-2-web",
  "description": "Small AWS web server template using t3.small in ap-northeast-2 region",
  "infraDynamicReq": {
    "nodeGroups": [
      {
        "name": "web",
        "nodeGroupSize": 1,
        "specId": "aws+ap-northeast-2+t3.small",
        "imageId": "ami-0fde5763b4c293a0b",
        "rootDiskType": "gp3",
        "rootDiskSize": 30
      }
    ],
    "sgTemplateId": "sg-usecase-web",
    "initScript": {
      "mode": "default",
      "templateId": "initscript-nginx",
      "env": {
        "SITE_TITLE": "CB-Tumblebug web demo"
      }
    }
  }
}
